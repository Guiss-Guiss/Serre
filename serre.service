[Unit]
Description=Système de Gestion de la Serre
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=votre_nom_utilisateur # Remplacer par votre nom d'utilisateur
Group=gpio
WorkingDirectory=/home/votre_nom_utilisateur # Remplacer par le chemin vers votre répertoire personnel
Environment=PYTHONUNBUFFERED=1
Environment=SERRE_CONFIG=/home/votre_nom_utilisateur/Serre/config.py # Remplacer par le chemin vers votre fichier config.py
ExecStart=/usr/bin/python3 /home/votre_nom_utilisateur/Serre/main.py # Remplacer par le chemin vers votre fichier main.py
Restart=always
RestartSec=5
TimeoutStopSec=60

OnFailure=notify-email@%n.service

StartLimitBurst=5

[Install]
WantedBy=multi-user.target